{
  "name": "nilbots-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run atlas:variants && vite",
    "build": "npm run build:cli && npm run atlas:variants && tsc -b && vite build",
    "build:review": "npm run atlas:variants && tsc -b && vite build --config vite.review.config.ts",
    "preview": "vite preview",
    "test": "npm run harness && node --import ./tests/support/register.mjs --test tests/*.test.ts",
    "review": "node ../scripts/review-preview.mjs",
    "atlas:variants": "node ../scripts/generate-atlas-variants.mjs",
    "atlas:clean": "node ../scripts/generate-atlas-variants.mjs --clean",
    "harness": "vite build --ssr tests/support/harness.entry.ts --outDir tests/.harness --logLevel error",
    "build:cli": "npm run atlas:clean && tsc -b && node ../scripts/build-cli-viewers.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@radix-ui/react-slider": "^1.3.5",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "marked": "^18.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
