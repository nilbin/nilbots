            "ventColor": "#d7662b"
          }
        },
        "material3d": {
          "normalMap": "pbr/wall-cover-normal.webp",
          "roughnessMap": "pbr/wall-cover-roughness.webp",
          "normalScale": 0.45,
          "roughness": 0.94,
          "metalness": 0.14
        }
      }
    }
