{
  "id": "ember-forge",
  "label": "Ember Forge",
  "environment3d": {
    "camera": {
      "yawDegrees": 12,
      "pitchDegrees": 52,
      "fovDegrees": 28
    },
    "lighting": {
      "keyColor": "#e7ded7",
      "keyIntensity": 3.25,
      "ambientColor": "#52606a",
      "ambientIntensity": 1.65,
      "fillColor": "#744936",
      "fillIntensity": 0.58
    },
    "floor": {
      "bumpScale": 0.028,
      "roughness": 0.98,
      "metalness": 0.12,
      "colorMultiplier": "#c7c7c7"
    }
  },
  "textures": {
    "floor": "floor-forge.webp"
  },
  "walls": {
    "defaults": {
      "boundary": "perimeter",
      "interior": "cover"
    },
    "atlas": {
      "columns": 16,
      "contentPixels": 192,
      "gutterPixels": 32
    },
    "families": {
      "perimeter": {
        "label": "Forge perimeter",
        "material": "wall-perimeter-albedo.webp",
        "edgeAtlas": "wall-perimeter-edges.webp",
        "shadowAtlas": "wall-perimeter-shadows.webp",
        "geometry3d": {
          "height": 0.84,
          "cornerRadius": 0.29,
          "upperProfile": {
            "height": 0.25,
            "inset": 0.035,
            "chamfer": 0.045
          },
          "details": {
            "panelEvery": 3,
            "ventEvery": 7,
            "clampEvery": 5,
            "panelColor": "#4f4b48",
            "clampColor": "#805239",
            "ventColor": "#dc682c"
          },
          "bastionCover": {
            "shoulderEvery": 3,
            "towerEvery": 7,
            "minRise": 0.1,
            "maxRise": 0.34,
            "boundaryDepth": 1.8,
            "bodyColor": "#242526",
            "trimColor": "#73503c",
            "heatColor": "#e56d2d"
          }
        },
        "material3d": {
          "normalMap": "pbr/wall-perimeter-normal.webp",
          "roughnessMap": "pbr/wall-perimeter-roughness.webp",
          "normalScale": 0.4,
          "roughness": 0.96,
          "metalness": 0.16,
          "colorMultiplier": "#c7c7c7"
        }
      },
      "cover": {
        "label": "Refractory cover",
        "material": "wall-cover-albedo.webp",
        "edgeAtlas": "wall-cover-edges.webp",
        "shadowAtlas": "wall-cover-shadows.webp",
        "geometry3d": {
          "height": 0.58,
          "cornerRadius": 0.35,
          "upperProfile": {
            "height": 0.18,
            "inset": 0.05,
            "chamfer": 0.035
          },
          "details": {
            "panelEvery": 3,
            "ventEvery": 9,
            "clampEvery": 7,
            "panelColor": "#57524e",
            "clampColor": "#744b37",
            "ventColor": "#ce5e28"
          },
          "bastionCover": {
            "shoulderEvery": 3,
            "towerEvery": 7,
            "minRise": 0.08,
            "maxRise": 0.28,
            "boundaryDepth": 0,
            "bodyColor": "#292a2b",
            "trimColor": "#684937",
            "heatColor": "#d45f28"
          }
        },
        "material3d": {
          "normalMap": "pbr/wall-cover-normal.webp",
          "roughnessMap": "pbr/wall-cover-roughness.webp",
          "normalScale": 0.34,
          "roughness": 0.97,
          "metalness": 0.12,
          "colorMultiplier": "#c7c7c7"
        }
      }
    }
  },
  "palette": {
    "canvas": "#090504",
    "arena": "#15100d",
    "floorTint": "rgba(24, 10, 4, 0.18)",
    "wallTint": "rgba(12, 5, 2, 0.14)",
    "zone": "#38d9c5",
    "frame": "#684229"
  }
}
