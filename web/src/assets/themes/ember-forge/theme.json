{
  "id": "ember-forge",
  "label": "Ember Forge",
  "environment3d": {
    "fog": {
      "unseenTerrainDarkness": 0.5,
      "visibleTerrainLift": 0.45
    },
    "camera": {
      "yawDegrees": 12,
      "pitchDegrees": 52,
      "fovDegrees": 28
    },
    "lighting": {
      "keyColor": "#eadfe2",
      "keyIntensity": 3.45,
      "ambientColor": "#4e5d68",
      "ambientIntensity": 1.78,
      "fillColor": "#7b2635",
      "fillIntensity": 0.62
    },
    "floor": {
      "bumpScale": 0.028,
      "roughness": 0.98,
      "metalness": 0.12,
      "albedoContrast": 0.68,
      "colorMultiplier": "#c7c7c7"
    }
  },
  "textures": {
    "floor": "floor-forge.webp"
  },
  "walls": {
    "defaults": {
      "boundary": "perimeter",
      "interior": "cover"
    },
    "atlas": {
      "columns": 16,
      "contentPixels": 192,
      "gutterPixels": 32
    },
    "families": {
      "perimeter": {
        "label": "Forge perimeter",
        "material": "wall-perimeter-albedo.webp",
        "edgeAtlas": "wall-perimeter-edges.webp",
        "shadowAtlas": "wall-perimeter-shadows.webp",
        "geometry3d": {
          "height": 0.84,
          "cornerRadius": 0.29,
          "upperProfile": {
            "height": 0.25,
            "inset": 0.035,
            "chamfer": 0.045
          },
          "details": {
            "panelEvery": 5,
            "ventEvery": 11,
            "clampEvery": 9,
            "panelColor": "#48474b",
            "clampColor": "#812d3b",
            "ventColor": "#f05536"
          },
          "bastionCover": {
            "shoulderEvery": 5,
            "towerEvery": 11,
            "hallEvery": 13,
            "chimneyEvery": 13,
            "furnaceEvery": 11,
            "minRise": 0.12,
            "maxRise": 0.42,
            "boundaryDepth": 1.8,
            "bodyColor": "#2c2d32",
            "trimColor": "#6b2a35",
            "accentColor": "#a63b4b",
            "heatColor": "#ff5838"
          }
        },
        "material3d": {
          "normalMap": "pbr/wall-perimeter-normal.webp",
          "roughnessMap": "pbr/wall-perimeter-roughness.webp",
          "normalScale": 0.4,
          "roughness": 0.96,
          "metalness": 0.16,
          "colorMultiplier": "#c7c7c7"
        }
      },
      "cover": {
        "label": "Refractory cover",
        "material": "wall-cover-albedo.webp",
        "edgeAtlas": "wall-cover-edges.webp",
        "shadowAtlas": "wall-cover-shadows.webp",
        "geometry3d": {
          "height": 0.58,
          "cornerRadius": 0.35,
          "upperProfile": {
            "height": 0.18,
            "inset": 0.05,
            "chamfer": 0.035
          },
          "details": {
            "panelEvery": 6,
            "ventEvery": 13,
            "clampEvery": 11,
            "panelColor": "#505055",
            "clampColor": "#702a36",
            "ventColor": "#e84934"
          },
          "bastionCover": {
            "shoulderEvery": 5,
            "towerEvery": 11,
            "hallEvery": 13,
            "chimneyEvery": null,
            "furnaceEvery": null,
            "minRise": 0.1,
            "maxRise": 0.4,
            "boundaryDepth": 0,
            "bodyColor": "#303136",
            "trimColor": "#632933",
            "accentColor": "#8f3241",
            "heatColor": "#ec4c35"
          }
        },
        "material3d": {
          "normalMap": "pbr/wall-cover-normal.webp",
          "roughnessMap": "pbr/wall-cover-roughness.webp",
          "normalScale": 0.34,
          "roughness": 0.97,
          "metalness": 0.12,
          "colorMultiplier": "#c7c7c7"
        }
      }
    }
  },
  "palette": {
    "canvas": "#080305",
    "arena": "#150b0e",
    "floorTint": "rgba(40, 5, 12, 0.12)",
    "wallTint": "rgba(35, 2, 10, 0.12)",
    "zone": "#38d9c5",
    "frame": "#702a38"
  }
}
