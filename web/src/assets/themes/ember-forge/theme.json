{
  "id": "ember-forge",
  "label": "Ember Forge",
  "environment3d": {
    "lighting": {
      "keyColor": "#f1d4c0",
      "keyIntensity": 3.6,
      "ambientColor": "#5d6670",
      "ambientIntensity": 1.8,
      "fillColor": "#8c5d42",
      "fillIntensity": 0.75
    },
    "floor": {
      "bumpScale": 0.045,
      "roughness": 0.95,
      "metalness": 0.16
    }
  },
  "textures": {
