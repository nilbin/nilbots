        "geometry3d": {
          "height": 0.72,
          "cornerRadius": 0.23,
          "upperProfile": {
            "height": 0.19,
            "inset": 0.025,
            "chamfer": 0.035
          },
          "details": {
            "panelEvery": 3,
            "ventEvery": 4,
            "clampEvery": 5,
            "panelColor": "#6d594d",
            "clampColor": "#8e5c3e",
            "ventColor": "#e2732f"
          }
        },
        "material3d": {
          "normalMap": "pbr/wall-perimeter-normal.webp",
          "roughnessMap": "pbr/wall-perimeter-roughness.webp",
