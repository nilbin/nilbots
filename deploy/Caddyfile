{$BOTARENA_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy {$BOTARENA_WEB_UPSTREAMS} {
		lb_policy cookie nilbots_web
		lb_try_duration 5s
		fail_duration 30s
		health_uri /health/ready
		health_interval 15s
		health_timeout 3s
		health_fails 2
		health_passes 1
	}

	log {
		output stdout
		format json
	}
}
