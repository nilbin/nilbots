{$BOTARENA_DOMAIN} {
	# The compiler-isolation gate is not complete yet. Keep the site public for
	# spectators, but do not let arbitrary internet visitors create accounts.
	# Replace this edge gate with an application-level invitation flow before
	# opening the friends pilot.
	@closedRegistration {
		method POST
		path /api/accounts/register
	}
	respond @closedRegistration "Registration is currently invite-only." 403

	encode zstd gzip

	header {
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy web:8080 {
		health_uri /health/ready
		health_interval 15s
		health_timeout 3s
	}

	log {
		output stdout
		format json
	}
}
