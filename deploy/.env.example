# Copy to deploy/.env and replace every CHANGE_ME value.
BOTARENA_DOMAIN=nilbots.example.com
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_HEX_VALUE
# `db` is the Compose service on the primary. Worker nodes must override this
# with the primary host's private-interface address.
BOTARENA_DB_HOST=db
# Keep loopback for a single host. Set a private-interface address when trusted
# application nodes need PostgreSQL; never set a public or wildcard address.
BOTARENA_POSTGRES_BIND_ADDRESS=127.0.0.1
# The same rule applies to the Garage S3 API used by remote application roles.
# Garage's admin and RPC interfaces remain unpublished.
BOTARENA_GARAGE_BIND_ADDRESS=127.0.0.1
BOTARENA_OPENIDDICT_CERT_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_HEX_VALUE
BOTARENA_NETWORK_HASH_KEY=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_HEX_VALUE

# Private, self-hosted S3-compatible storage. Generate each secret separately:
#   openssl rand -hex 32
# Access keys use Garage's GK prefix:
#   printf 'GK%s\n' "$(openssl rand -hex 16)"
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARACTERS
GARAGE_ADMIN_TOKEN=CHANGE_ME_ANOTHER_64_HEX_CHARACTERS
GARAGE_METRICS_TOKEN=CHANGE_ME_ANOTHER_64_HEX_CHARACTERS
GARAGE_ZONE=hostup-stockholm
GARAGE_NODE_CAPACITY=10GB

BOTARENA_OBJECT_STORE=s3
BOTARENA_S3_ENDPOINT=http://garage-gateway:3900
BOTARENA_S3_ALLOW_HTTP=true
BOTARENA_S3_REGION=garage
BOTARENA_S3_BUCKET=nilbots
BOTARENA_S3_ACCESS_KEY=CHANGE_ME_GK_PLUS_32_HEX_CHARACTERS
BOTARENA_S3_SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS

# `deploy.sh --build-local` tags local images with the checked-out Git commit.
# Manual GitHub releases instead write immutable GHCR digests to the ignored
# `deploy/release.env`; image references and secrets stay out of this file.

BOTARENA_COMPILE_WORKERS=1
BOTARENA_COMPILE_CPUS=3
BOTARENA_COMPILE_MEMORY=3g
BOTARENA_COMPILE_COORDINATOR_CPUS=0.5
BOTARENA_COMPILE_COORDINATOR_MEMORY=512m
BOTARENA_COMPILE_WORKSPACE_SIZE=1g
BOTARENA_BUILD_TIMEOUT_SECONDS=300
BOTARENA_COMPILE_ACCOUNT_10M=6
BOTARENA_COMPILE_ACCOUNT_DAILY=30
BOTARENA_COMPILE_NETWORK_10M=12
BOTARENA_COMPILE_NETWORK_DAILY=60
BOTARENA_COMPILE_ACCOUNT_QUEUED=2
BOTARENA_COMPILE_GLOBAL_QUEUED=20
BOTARENA_MATCH_MEMORY=1g
BOTARENA_WEB_MEMORY=768m

BOTARENA_BROADCAST_TPS=5
BOTARENA_BROADCAST_DELAY_SECONDS=3
BOTARENA_MATCH_INSTANCE_ID=match-1
BOTARENA_COMPILE_INSTANCE_ID=compile-1
