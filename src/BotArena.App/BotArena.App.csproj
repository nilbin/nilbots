<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The modular monolith (plan §2, §19): one ASP.NET Core app, one PostgreSQL
       database, feature folders (Accounts/Bots/Matches/Jobs), direct in-process
       module communication, DB-backed background jobs. No microservices. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BotArena.Engine/BotArena.Engine.csproj" />
    <ProjectReference Include="../BotArena.Runtime.Wasm/BotArena.Runtime.Wasm.csproj" />
    <ProjectReference Include="../BotArena.Toolchain/BotArena.Toolchain.csproj" />
    <ProjectReference Include="../BotArena.Runtime/BotArena.Runtime.csproj" />
    <ProjectReference Include="../BotArena.Bots.BuiltIn/BotArena.Bots.BuiltIn.csproj" />
  </ItemGroup>
</Project>
