<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The modular monolith (plan §2, §19): one ASP.NET Core app, one PostgreSQL
       database, feature folders (Accounts/Bots/Matches/Jobs), direct in-process
       module communication, DB-backed background jobs. No microservices. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.4" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageReference Include="OpenIddict.Client.AspNetCore" Version="7.6.0" />
    <PackageReference Include="OpenIddict.Client.WebIntegration" Version="7.6.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../cosmetics/catalog.json" LogicalName="BotArena.Cosmetics.catalog.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BotArena.TacticalPlaybooks/BotArena.TacticalPlaybooks.csproj" />
    <ProjectReference Include="../BotArena.Engine/BotArena.Engine.csproj" />
    <ProjectReference Include="../BotArena.Runtime.Wasm/BotArena.Runtime.Wasm.csproj" />
    <ProjectReference Include="../BotArena.Toolchain/BotArena.Toolchain.csproj" />
    <ProjectReference Include="../BotArena.Runtime/BotArena.Runtime.csproj" />
    <ProjectReference Include="../BotArena.Bots.BuiltIn/BotArena.Bots.BuiltIn.csproj" />
    <!-- Exact managed twin of the current operation-capable stock WASM. Keeping
         it in its own assembly avoids type collisions with frozen v0 sources. -->
    <ProjectReference Include="../../arena-bots/arc-relay/stock-mind-v4/ArcRelayStrategyMind.csproj" />
    <ProjectReference Include="../../arena-bots/arc-relay/tactical-playbook-mind-v1/ArcRelayTacticalPlaybookMind.csproj" />
    <!-- Not used by any App code: it puts BotArena.Guest.dll beside the server the way
         it already sits beside the CLI, so both hosts stage the assemblies they shipped
         with. Without it the server had only Sdk.dll here and silently fell back to
         building its own copies from the repo — a different build of a different
         configuration than the CLI staged (DECISIONS #84). -->
    <ProjectReference Include="../BotArena.Guest/BotArena.Guest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source-authored Orders v2 templates. Map-plan hashes are compiler
         output, never fields players have to pin. -->
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/tactics/first-stand-v1.json"
                      LogicalName="BotArena.Sheets.first-stand-v1.tactics.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/tactics/mid-pincer-v1.json"
                      LogicalName="BotArena.Sheets.mid-pincer-v1.tactics.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/starter-tapline-v2.json"
      LogicalName="BotArena.Sheets.starter-v2.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/starter-tapline-v2.json"
      LogicalName="BotArena.Sheets.starter-v2.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/running-relay-solo-v1.json"
      LogicalName="BotArena.Sheets.running-relay-solo-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/running-relay-solo-v1.json"
      LogicalName="BotArena.Sheets.running-relay-solo-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/mid-overload-drill-v1.json"
      LogicalName="BotArena.Sheets.mid-overload-drill-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/mid-overload-drill-v1.json"
      LogicalName="BotArena.Sheets.mid-overload-drill-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/tempered-standard-v2.json"
      LogicalName="BotArena.Sheets.tempered-standard-v2.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/tempered-standard-v2.json"
      LogicalName="BotArena.Sheets.tempered-standard-v2.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/relay-circuit-v1.json"
      LogicalName="BotArena.Sheets.relay-circuit-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/relay-circuit-v1.json"
      LogicalName="BotArena.Sheets.relay-circuit-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/crowned-rail-v1.json"
      LogicalName="BotArena.Sheets.crowned-rail-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/crowned-rail-v1.json"
      LogicalName="BotArena.Sheets.crowned-rail-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/lockbox-v1.json"
      LogicalName="BotArena.Sheets.lockbox-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/lockbox-v1.json"
      LogicalName="BotArena.Sheets.lockbox-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/demolition-march-v1.json"
      LogicalName="BotArena.Sheets.demolition-march-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/demolition-march-v1.json"
      LogicalName="BotArena.Sheets.demolition-march-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/rising-standard-v1.json"
      LogicalName="BotArena.Sheets.rising-standard-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/rising-standard-v1.json"
      LogicalName="BotArena.Sheets.rising-standard-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/wavebreak-v1.json"
      LogicalName="BotArena.Sheets.wavebreak-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/wavebreak-v1.json"
      LogicalName="BotArena.Sheets.wavebreak-v1.map-plan.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/playbooks/idle-field-v1.json"
      LogicalName="BotArena.Sheets.idle-field-v1.sheet.json" />
    <EmbeddedResource Include="../../arena-bots/arc-relay/tactical-playbook-v1-2026-08-03/map-plans/tapline-6/idle-field-v1.json"
      LogicalName="BotArena.Sheets.idle-field-v1.map-plan.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- One frozen first-party stock algorithm is compiled once into the
         trusted hosted worker. The exact same sources build its WASM audit
         twin; player sheets remain separately hashed data. -->
    <Compile Include="../../arena-bots/arc-relay/stock-mind-v0/ArcRelayStockMind.cs"
             Link="ArcRelay/StockMind/ArcRelayStockMind.cs" />
    <Compile Include="../../arena-bots/arc-relay/stock-mind-v0/StockSheet.cs"
             Link="ArcRelay/StockMind/StockSheet.cs" />
  </ItemGroup>

  <!-- The OpenAPI document is a build artifact, not a running-server artifact: it is
       emitted here so client generation and the CI drift check never need a live app
       or a database. Regenerate clients with scripts/generate-api-clients.sh. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

</Project>
