<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>botarena</AssemblyName>
    <RootNamespace>BotArena.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nilbots</ToolCommandName>
    <PackageId>Nilbots</PackageId>
    <!-- Lockstep with ToolchainInfo.CliVersion (PackagedCliVersionTests). -->
    <Version>0.9.33</Version>
    <Authors>nilbin</Authors>
    <Description>Build, test, replay, and submit C# bots for the nilbots programming game.</Description>
    <PackageProjectUrl>https://nilbots.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nilbin/nilbots</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nilbots;bot;game;webassembly;wasm;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- A match is an allocation-heavy batch job, not an interactive app: the
         Arc Relay evaluation cell allocates ~1 GiB in one 400-tick run. Server
         GC (DATAS-sized, so a laptop running a sweep in parallel does not get
         one heap per core) collects that at ~5% less wall clock than
         workstation GC both serially and at six concurrent cells. Gameplay is
         unaffected — the GC never observes simulation state. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BotArena.Engine/BotArena.Engine.csproj" />
    <ProjectReference Include="../BotArena.Runtime/BotArena.Runtime.csproj" />
    <ProjectReference Include="../BotArena.Toolchain/BotArena.Toolchain.csproj" />
    <ProjectReference Include="../BotArena.Runtime.Wasm/BotArena.Runtime.Wasm.csproj" />
    <ProjectReference Include="../BotArena.Bots.BuiltIn/BotArena.Bots.BuiltIn.csproj" />
    <ProjectReference Include="../BotArena.Guest/BotArena.Guest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../artifacts/wasm/builtin-bots.wasm"
          Pack="true"
          PackagePath="tools/net10.0/any/artifacts/wasm/" />
    <None Include="../../docker/wasm-builder.Dockerfile"
          Pack="true"
          PackagePath="tools/net10.0/any/docker/" />
    <None Include="../../maps/*.json"
          Pack="true"
          PackagePath="tools/net10.0/any/maps/" />
    <None Include="../../maps/experimental/*.json"
          Pack="true"
          PackagePath="tools/net10.0/any/maps/experimental/" />
    <None Include="../../nuget.config"
          Pack="true"
          PackagePath="tools/net10.0/any/" />
    <None Include="../../scripts/run-wasm-publish.sh"
          Pack="true"
          PackagePath="tools/net10.0/any/scripts/" />
    <None Include="../../scripts/setup-wasi-sdk.sh"
          Pack="true"
          PackagePath="tools/net10.0/any/scripts/" />
    <!-- The canonical player rules card. `nilbots new` splices it into the scaffolded
         README so the rules have exactly ONE source: this file also backs
         /llms-full.txt on the server. Ship it with the tool or `new` cannot inline it. -->
    <None Include="../../docs/PLAYER-GUIDE.md"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="tools/net10.0/any/docs/" />
    <None Include="../../docs/EXPERIMENTAL-FRONTLINE.md"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="tools/net10.0/any/docs/" />
    <None Include="../../docs/FRONTLINE-LABS-RULES.md"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="tools/net10.0/any/docs/" />
    <None Include="../../templates/botarena-bot/*"
          Pack="true"
          PackagePath="tools/net10.0/any/templates/botarena-bot/" />
    <None Include="../../templates/botarena-generic-actor/*"
          Pack="true"
          PackagePath="tools/net10.0/any/templates/botarena-generic-actor/" />
    <None Include="../../templates/botarena-generic-mind/*"
          Pack="true"
          PackagePath="tools/net10.0/any/templates/botarena-generic-mind/" />
    <!-- One self-contained viewer per map theme; the CLI picks by the replay's
         ThemeId. See ReplayOutput and web/vite.cli.config.ts. -->
    <None Include="../../web/dist-cli/**/index.html"
          Pack="true"
          PackagePath="tools/net10.0/any/web/dist-cli/" />
  </ItemGroup>
</Project>
