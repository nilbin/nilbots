{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nilbots.com/schemas/balance-lab-spec-1.json",
  "title": "Nilbots Balance Lab experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "status",
    "evidenceClass",
    "hypothesis",
    "factors",
    "pairedSeeds",
    "holdoutSeeds",
    "verifyCommand",
    "evaluationProfileId",
    "candidates",
    "populations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "experimentId": { "$ref": "#/$defs/slug" },
    "status": { "const": "experimental" },
    "evidenceClass": {
      "enum": [
        "compatibility",
        "same-cohort-causality",
        "native-product",
        "infrastructure-smoke"
      ]
    },
    "hypothesis": { "type": "string", "minLength": 1 },
    "factors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/slug" }
      }
    },
    "pairedSeeds": { "$ref": "#/$defs/seeds" },
    "holdoutSeeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "verifyCommand": { "type": "string", "minLength": 1 },
    "evaluationProfileId": {
      "enum": ["two-team-zero-sum-v1"]
    },
    "dynamicsAdapter": {
      "enum": ["generic-frontline-replay-v3"]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "populations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/population" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modeId",
        "rulesetId",
        "rulesFingerprint",
        "mapId",
        "mapVersion",
        "mapFingerprint",
        "formatId",
        "formatFingerprint",
        "topologyProfileId",
        "topologyFingerprint",
        "contractProfileId",
        "matchContractFingerprint"
      ],
      "properties": {
        "modeId": { "$ref": "#/$defs/slug" },
        "rulesetId": { "$ref": "#/$defs/slug" },
        "rulesFingerprint": { "$ref": "#/$defs/fingerprint" },
        "mapId": { "$ref": "#/$defs/slug" },
        "mapVersion": { "type": "integer", "minimum": 1 },
        "mapFingerprint": { "$ref": "#/$defs/fingerprint" },
        "formatId": { "$ref": "#/$defs/slug" },
        "formatFingerprint": { "$ref": "#/$defs/fingerprint" },
        "topologyProfileId": { "$ref": "#/$defs/slug" },
        "topologyFingerprint": { "$ref": "#/$defs/fingerprint" },
        "contractProfileId": { "$ref": "#/$defs/slug" },
        "matchContractFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "factors",
        "runnerCommand",
        "contract"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "factors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/slug" },
          "additionalProperties": { "$ref": "#/$defs/slug" }
        },
        "runnerCommand": { "type": "string", "minLength": 1 },
        "contract": { "$ref": "#/$defs/contract" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteId",
        "suiteVersion",
        "qualificationProfileId",
        "qualificationContractFingerprint",
        "evidence",
        "evidenceSha256",
        "tierAwarded",
        "coordinationGradeAwarded",
        "balanceEvidenceEligible"
      ],
      "properties": {
        "suiteId": { "$ref": "#/$defs/slug" },
        "suiteVersion": { "type": "integer", "minimum": 1 },
        "qualificationProfileId": { "$ref": "#/$defs/slug" },
        "qualificationContractFingerprint": {
          "oneOf": [
            { "$ref": "#/$defs/fingerprint" },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": ["string", "null"]
        },
        "evidenceSha256": {
          "oneOf": [
            { "$ref": "#/$defs/fingerprint" },
            { "type": "null" }
          ]
        },
        "tierAwarded": { "type": ["string", "null"] },
        "coordinationGradeAwarded": {
          "type": ["string", "null"]
        },
        "balanceEvidenceEligible": { "type": "boolean" }
      }
    },
    "entrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "root",
        "artifact",
        "artifactSha256",
        "sourceTreeSha256",
        "qualification"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/fingerprint" },
        "sourceTreeSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "qualification": { "$ref": "#/$defs/qualification" }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "coordinationGrade",
        "qualificationProfileId",
        "qualificationContractFingerprint",
        "balanceEvidenceEligible",
        "entrants"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "tier": { "type": "string", "minLength": 1 },
        "coordinationGrade": { "type": "string", "minLength": 1 },
        "qualificationProfileId": { "$ref": "#/$defs/slug" },
        "qualificationContractFingerprint": {
          "oneOf": [
            { "$ref": "#/$defs/fingerprint" },
            { "type": "null" }
          ]
        },
        "balanceEvidenceEligible": { "type": "boolean" },
        "entrants": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/entrant" }
        }
      }
    }
  }
}
