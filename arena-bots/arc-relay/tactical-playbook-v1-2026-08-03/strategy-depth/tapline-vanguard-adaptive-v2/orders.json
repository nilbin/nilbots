{
  "schema": "arc-relay-orders-v2",
  "sheetId": "tapline-vanguard-adaptive-v2",
  "mapPlan": "map-plan.json",
  "roles": [
    {
      "id": "home-runner",
      "classes": ["relay"],
      "upgradePath": ["vitality", "vision"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "id": "arc-pass-home", "when": { "all": ["carrying-core", "signature-ready"] }, "use": { "skill": "arc-toss", "target": "nearest-ally-toward-own-reactor" } },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        { "shared": "fight-visible-enemy" },
        { "id": "hold-home-well", "move": { "to": { "well": "own" }, "posture": "rear" } }
      ]
    },
    {
      "id": "centre-guard",
      "classes": ["hush", "repulsor", "patchbay"],
      "upgradePath": ["vitality", "damage", "vision"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        {
          "id": "break-return-denial",
          "when": { "all": ["empty-handed", "home-lane-overloaded"] },
          "until": "home-lane-cleared",
          "timeout": 120,
          "cooldown": 8,
          "urgency": "urgent",
          "orders": [
            { "id": "silence-home-denial", "when": "signature-ready", "use": { "skill": "null-field", "target": "self" } },
            { "id": "scatter-home-denial", "when": { "all": ["enemy-nearby", "signature-ready"] }, "use": { "skill": "kinetic-burst", "target": "self" } },
            { "id": "repair-home-sweep", "when": "signature-ready", "use": { "skill": "repair-beam", "target": "weakest-ally" } },
            { "id": "fight-home-denial", "when": "enemy-nearby", "fight": { "targets": ["carrier", "weakest", "nearest"], "style": "advance", "chaseLimit": 5 } },
            { "id": "close-home-well", "move": { "to": { "well": "own" }, "posture": "front" } }
          ]
        },
        { "shared": "collect-loose-core" },
        { "id": "silence-centre", "when": { "all": ["enemy-nearby", "signature-ready"] }, "use": { "skill": "null-field", "target": "self" } },
        { "id": "scatter-centre", "when": { "all": ["enemy-nearby", "signature-ready"] }, "use": { "skill": "kinetic-burst", "target": "self" } },
        { "id": "repair-centre", "when": "signature-ready", "use": { "skill": "repair-beam", "target": "weakest-ally" } },
        { "shared": "fight-visible-enemy" },
        { "id": "hold-centre-well", "move": { "to": { "well": "centre" }, "posture": "line" } }
      ]
    },
    {
      "id": "far-raiders",
      "classes": ["towline", "towline"],
      "upgradePath": ["damage", "vision", "vitality"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "collect-loose-core" },
        { "shared": "recover-health" },
        { "id": "hook-carrier", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "capacity": 2, "use": { "skill": "tractor-hook", "target": "enemy-carrier" } },
        { "shared": "fight-visible-enemy" },
        { "id": "hold-far-well", "move": { "to": { "well": "enemy" }, "posture": "front" } }
      ]
    },
    {
      "id": "medic",
      "classes": ["patchbay"],
      "upgradePath": ["reach", "vitality"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        { "id": "repair-front", "when": "signature-ready", "use": { "skill": "repair-beam", "target": "weakest-ally" } },
        { "shared": "fight-visible-enemy" },
        { "id": "trail-far-raiders", "move": { "follow": "far-raiders", "posture": "rear" } }
      ]
    },
    {
      "id": "flank-scout",
      "classes": ["kestrel"],
      "upgradePath": ["reach", "vitality"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        {
          "id": "flank-ingress",
          "until": "on-enemy-approach",
          "timeout": 55,
          "cooldown": 1200,
          "orders": [{ "id": "reach-flank-rally", "urgency": "urgent", "move": { "to": { "anchor": "flank-rally" }, "posture": "line", "via": "north-flank-ingress" } }]
        },
        { "id": "dash-through-contact", "when": { "all": ["empty-handed", "on-enemy-approach", "signature-ready"] }, "use": { "skill": "vector-dash", "target": "self" } },
        { "shared": "recover-health" },
        { "shared": "fight-visible-enemy" },
        { "id": "pressure-far-well", "move": { "to": { "well": "enemy" }, "posture": "front" } }
      ]
    }
  ],
  "sharedOrders": {
    "handoff-core-forward": { "when": "carrying-core", "handoff": { "target": "nearest-ally-toward-own-reactor" } },
    "score-a-core": {
      "when": "carrying-core",
      "until": "empty-handed",
      "timeout": 180,
      "cooldown": 2,
      "urgency": "urgent",
      "orders": [{ "id": "return-to-reactor", "move": { "to": "own-reactor" } }]
    },
    "collect-loose-core": {
      "when": { "all": ["empty-handed", "loose-core-known"] },
      "capacity": "two-per-core",
      "move": { "to": "nearest-known-loose-core" }
    },
    "recover-health": {
      "when": "hurt",
      "until": "healthy",
      "timeout": 16,
      "cooldown": 18,
      "urgency": "urgent",
      "move": { "to": "nearest-heal-zone", "posture": "rear" }
    },
    "fight-visible-enemy": {
      "when": { "all": ["empty-handed", "enemy-nearby"] },
      "fight": { "targets": ["carrier", "weakest", "nearest"], "style": "advance", "chaseLimit": 3 }
    }
  },
  "capacities": { "two-per-core": 2 },
  "conditions": {
    "carrying-core": { "fact": "self-carrying", "operator": "equals", "value": 1 },
    "empty-handed": { "fact": "self-carrying", "operator": "equals", "value": 0 },
    "loose-core-known": { "fact": "known-loose-cores", "operator": "at-least", "value": 1 },
    "hurt": { "fact": "self-health-percent", "operator": "at-most", "value": 35 },
    "healthy": { "fact": "self-health-percent", "operator": "at-least", "value": 75 },
    "enemy-nearby": { "fact": "self-nearest-visible-enemy-distance", "operator": "at-most", "value": 7 },
    "signature-ready": { "fact": "signature-ready", "operator": "equals", "value": 1 },
    "home-lane-overloaded": { "fact": "remembered-enemies-in-zone", "operator": "at-least", "value": 3, "zone": "home-return-sector", "freshnessTicks": 45 },
    "home-lane-cleared": { "fact": "remembered-enemies-in-zone", "operator": "at-most", "value": 1, "zone": "home-return-sector", "freshnessTicks": 18 },
    "on-enemy-approach": { "fact": "self-in-zone", "operator": "equals", "value": 1, "zone": "enemy-approach" }
  }
}
