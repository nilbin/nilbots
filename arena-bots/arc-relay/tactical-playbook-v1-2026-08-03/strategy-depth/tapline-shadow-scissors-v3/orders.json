{
  "schema": "arc-relay-orders-v2",
  "sheetId": "tapline-shadow-scissors-v3",
  "mapPlan": "map-plan.json",
  "roles": [
    {
      "id": "north-wing",
      "classes": ["kestrel", "kestrel", "veil", "hush"],
      "upgradePath": ["reach", "damage", "vision"],
      "orders": [
        { "shared": "drop-core-under-contact" }, { "shared": "score-a-core" }, { "shared": "collect-loose-core" }, { "shared": "recover-health" },
        { "id": "dash-north-contact", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "vector-dash", "target": "nearest-enemy" } },
        { "id": "smoke-north-contact", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "smoke-canister", "target": "self" } },
        { "id": "silence-north-contact", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "null-field", "target": "self" } },
        { "shared": "fight-visible-enemy" },
        { "id": "north-wing-raid", "move": { "patrol": "enemy-well-loop", "via": "north-shadow-ingress", "posture": "front" } }
      ]
    },
    {
      "id": "south-wing",
      "classes": ["towline", "sunder", "patchbay", "relay"],
      "upgradePath": ["damage", "vitality", "vision"],
      "orders": [
        { "shared": "drop-core-under-contact" }, { "shared": "score-a-core" }, { "shared": "collect-loose-core" }, { "shared": "recover-health" },
        { "id": "hook-south-carrier", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "tractor-hook", "target": "enemy-carrier" } },
        { "id": "paint-south-carrier", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "target-paint", "target": "enemy-carrier" } },
        { "id": "repair-south-wing", "when": "signature-ready", "use": { "skill": "repair-beam", "target": "weakest-ally" } },
        { "id": "arc-pass-south-wing", "when": { "all": ["carrying-core", "signature-ready"] }, "use": { "skill": "arc-toss", "target": "nearest-ally-toward-own-reactor" } },
        { "shared": "fight-visible-enemy" },
        { "id": "south-wing-raid", "move": { "patrol": "enemy-well-loop", "via": "south-shadow-ingress", "posture": "front" } }
      ]
    }
  ],
  "sharedOrders": {
    "drop-core-under-contact": { "when": { "all": ["carrying-core", "enemy-contact"] }, "drop": true },
    "score-a-core": { "when": "carrying-core", "until": "empty-handed", "timeout": 180, "cooldown": 2, "urgency": "urgent", "orders": [
      { "id": "return-to-reactor", "move": { "to": "own-reactor" } }
    ] },
    "collect-loose-core": { "when": { "all": ["empty-handed", "loose-core-known"] }, "capacity": "two-per-core", "move": { "to": "nearest-known-loose-core" } },
    "recover-health": { "when": "hurt", "until": "healthy", "timeout": 16, "cooldown": 18, "urgency": "urgent", "orders": [
      { "id": "reach-healing", "move": { "to": "nearest-heal-zone", "posture": "rear" } }
    ] },
    "fight-visible-enemy": { "when": { "all": ["empty-handed", "enemy-nearby"] }, "fight": { "targets": ["carrier", "marked", "medic", "weakest", "nearest"], "style": "advance", "chaseLimit": 5 } }
  },
  "capacities": { "two-per-core": 2 },
  "conditions": {
    "carrying-core": { "fact": "self-carrying", "operator": "equals", "value": 1 },
    "empty-handed": { "fact": "self-carrying", "operator": "equals", "value": 0 },
    "loose-core-known": { "fact": "known-loose-cores", "operator": "at-least", "value": 1 },
    "hurt": { "fact": "self-health-percent", "operator": "at-most", "value": 35 },
    "healthy": { "fact": "self-health-percent", "operator": "at-least", "value": 75 },
    "enemy-nearby": { "fact": "self-nearest-visible-enemy-distance", "operator": "at-most", "value": 7 },
    "enemy-contact": { "fact": "self-nearest-visible-enemy-distance", "operator": "at-most", "value": 1 },
    "signature-ready": { "fact": "signature-ready", "operator": "equals", "value": 1 }
  }
}
