        ]
      },
      "fight": {
        "targets": [
          "carrier",
          "weakest",
          "nearest"
        ],
        "style": "kite",
        "chaseLimit": 3
      }
    }
  },
  "capacities": {
    "two-per-core": 2
  },
  "conditions": {
