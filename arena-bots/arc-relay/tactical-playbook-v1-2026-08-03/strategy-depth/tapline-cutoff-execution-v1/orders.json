        "lantern",
        "patchbay",
        "relay"
      ],
      "upgradePath": [
        "vision",
        "vitality",
        "reach",
        "damage"
      ],
      "orders": [
        {
          "shared": "score-a-core"
        },
        {
          "shared": "collect-loose-core"
        },
        {
          "shared": "recover-health"
        },
        {
          "id": "reveal-cutoff-target",
