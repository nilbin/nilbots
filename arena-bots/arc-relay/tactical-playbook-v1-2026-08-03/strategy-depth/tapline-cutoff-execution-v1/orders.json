      "operator": "equals",
      "value": 0
    },
    "loose-core-known": {
      "fact": "known-loose-cores",
      "operator": "at-least",
      "value": 1
    },
    "hurt": {
      "fact": "self-health-percent",
      "operator": "at-most",
      "value": 35
    },
    "healthy": {
      "fact": "self-health-percent",
      "operator": "at-least",
      "value": 75
    },
    "enemy-nearby": {
      "fact": "self-nearest-visible-enemy-distance",
      "operator": "at-most",
      "value": 7
    },
    "signature-ready": {
      "fact": "signature-ready",
      "operator": "equals",
      "value": 1
