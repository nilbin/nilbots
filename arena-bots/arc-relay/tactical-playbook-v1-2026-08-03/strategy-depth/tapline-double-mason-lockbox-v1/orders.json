  "sharedOrders": {
    "score-a-core": {
      "when": "carrying-core",
      "until": "empty-handed",
      "timeout": 180,
      "cooldown": 2,
      "urgency": "urgent",
      "orders": [
        {
          "id": "return-to-reactor",
          "move": {
            "to": "own-reactor"
          }
        }
      ]
    },
    "collect-loose-core": {
      "when": {
        "all": [
          "empty-handed",
          "loose-core-known"
        ]
      },
      "capacity": "two-per-core",
      "move": {
        "to": "nearest-known-loose-core"
      }
    },
    "recover-health": {
      "when": "hurt",
      "until": "healthy",
      "timeout": 16,
      "cooldown": 18,
      "urgency": "urgent",
      "orders": [
        {
          "id": "reach-healing",
          "move": {
            "to": "nearest-heal-zone",
            "posture": "rear"
          }
        }
      ]
    },
    "fight-visible-enemy": {
      "when": {
        "all": [
          "empty-handed",
          "enemy-nearby"
        ]
      },
      "fight": {
        "targets": [
          "carrier",
          "weakest",
          "nearest"
        ],
        "style": "advance",
        "chaseLimit": 4
      }
    }
  },
  "capacities": {
    "two-per-core": 2
  },
  "conditions": {
    "carrying-core": {
      "fact": "self-carrying",
      "operator": "equals",
      "value": 1
    },
    "empty-handed": {
      "fact": "self-carrying",
      "operator": "equals",
      "value": 0
    },
    "loose-core-known": {
      "fact": "known-loose-cores",
      "operator": "at-least",
      "value": 1
    },
    "hurt": {
      "fact": "self-health-percent",
      "operator": "at-most",
      "value": 35
    },
    "healthy": {
      "fact": "self-health-percent",
      "operator": "at-least",
      "value": 75
    },
    "enemy-nearby": {
      "fact": "self-nearest-visible-enemy-distance",
      "operator": "at-most",
      "value": 7
    },
    "signature-ready": {
      "fact": "signature-ready",
      "operator": "equals",
      "value": 1
    },
    "deployment-missing": {
      "fact": "deployment-active",
      "operator": "equals",
      "value": 0
    },
    "deployment-expiring": {
      "fact": "deployment-lifetime-percent",
      "operator": "at-most",
      "value": 20
    },
    "deployment-damaged": {
      "fact": "deployment-durability-percent",
      "operator": "at-most",
      "value": 34
    }
  }
}
