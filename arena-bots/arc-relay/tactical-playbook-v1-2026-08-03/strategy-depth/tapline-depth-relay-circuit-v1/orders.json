  "sharedOrders": {
    "score-a-core": {
      "when": "carrying-core",
      "until": "empty-handed",
      "timeout": 180,
      "cooldown": 2,
      "urgency": "urgent",
      "orders": [
        {
          "id": "return-to-reactor",
          "move": {
            "to": "own-reactor"
          }
        }
      ]
    },
    "collect-loose-core": {
      "when": {
        "all": [
          "empty-handed",
          "loose-core-known"
        ]
      },
      "capacity": "two-per-core",
      "move": {
        "to": "highest-bank-value-known-loose-core"
      }
    },
    "recover-health": {
      "when": "hurt",
      "until": "healthy",
      "timeout": 16,
      "cooldown": 18,
      "urgency": "urgent",
      "orders": [
