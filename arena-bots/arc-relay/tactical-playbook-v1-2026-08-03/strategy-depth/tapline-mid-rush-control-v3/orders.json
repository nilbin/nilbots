{
  "schema": "arc-relay-orders-v2",
  "sheetId": "tapline-mid-rush-control-v3",
  "mapPlan": "map-plan.json",
  "roles": [
    {
      "id": "mid-pack",
      "classes": ["kestrel", "kestrel", "veil", "hush", "towline", "sunder", "patchbay", "relay"],
      "upgradePath": ["damage", "vitality", "vision"],
      "orders": [
        { "id": "drop-core-under-contact", "when": { "all": ["carrying-core", "enemy-contact"] }, "drop": true },
        { "id": "score-a-core", "when": "carrying-core", "until": "empty-handed", "timeout": 180, "cooldown": 2, "urgency": "urgent", "orders": [
          { "id": "return-to-reactor", "move": { "to": "own-reactor" } }
        ] },
        { "id": "collect-loose-core", "when": { "all": ["empty-handed", "loose-core-known"] }, "capacity": 2, "move": { "to": "nearest-known-loose-core" } },
        { "id": "recover-health", "when": "hurt", "until": "healthy", "timeout": 16, "cooldown": 18, "urgency": "urgent", "orders": [
          { "id": "reach-healing", "move": { "to": "nearest-heal-zone", "posture": "rear" } }
        ] },
        { "id": "dash-mid-contact", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "vector-dash", "target": "nearest-enemy" } },
        { "id": "smoke-mid-contact", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "smoke-canister", "target": "self" } },
        { "id": "silence-mid-contact", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "null-field", "target": "self" } },
        { "id": "hook-mid-carrier", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "tractor-hook", "target": "enemy-carrier" } },
        { "id": "paint-mid-carrier", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "target-paint", "target": "enemy-carrier" } },
        { "id": "repair-mid-pack", "when": "signature-ready", "use": { "skill": "repair-beam", "target": "weakest-ally" } },
        { "id": "arc-pass-mid-pack", "when": { "all": ["carrying-core", "signature-ready"] }, "use": { "skill": "arc-toss", "target": "nearest-ally-toward-own-reactor" } },
        { "id": "fight-visible-enemy", "when": { "all": ["empty-handed", "enemy-nearby"] }, "fight": { "targets": ["carrier", "marked", "weakest", "nearest"], "style": "advance", "chaseLimit": 5 } },
        { "id": "pressure-enemy-well", "when": "enemy-core-outstanding", "move": { "patrol": "enemy-well-pressure-loop", "posture": "front" } },
        { "id": "control-centre", "move": { "patrol": "centre-control-loop", "posture": "front" } }
      ]
    }
  ],
  "sharedOrders": {},
  "capacities": {},
  "conditions": {
    "carrying-core": { "fact": "self-carrying", "operator": "equals", "value": 1 },
    "empty-handed": { "fact": "self-carrying", "operator": "equals", "value": 0 },
    "loose-core-known": { "fact": "known-loose-cores", "operator": "at-least", "value": 1 },
    "hurt": { "fact": "self-health-percent", "operator": "at-most", "value": 35 },
    "healthy": { "fact": "self-health-percent", "operator": "at-least", "value": 75 },
    "enemy-nearby": { "fact": "self-nearest-visible-enemy-distance", "operator": "at-most", "value": 7 },
    "enemy-contact": { "fact": "self-nearest-visible-enemy-distance", "operator": "at-most", "value": 1 },
    "signature-ready": { "fact": "signature-ready", "operator": "equals", "value": 1 },
    "enemy-core-outstanding": { "fact": "well-has-outstanding-core", "operator": "equals", "value": 1, "well": "enemy" }
  }
}
