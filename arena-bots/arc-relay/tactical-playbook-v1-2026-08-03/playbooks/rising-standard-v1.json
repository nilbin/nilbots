          "empty-handed",
          "enemy-nearby"
        ]
      },
      "fight": {
        "targets": [
          "veteran",
          "carrier",
          "weakest",
          "nearest"
        ],
        "style": "advance",
        "chaseLimit": 4
      }
    }
  },
  "capacities": {
