    "empty-handed": {
      "fact": "self-carrying",
      "operator": "equals",
      "value": 0
    },
    "loose-core-known": {
      "fact": "known-loose-cores",
      "operator": "at-least",
      "value": 1
    },
    "hurt": {
      "fact": "self-health-percent",
      "operator": "at-most",
      "value": 35
    },
    "healthy": {
      "fact": "self-health-percent",
      "operator": "at-least",
      "value": 75
    },
    "enemy-nearby": {
