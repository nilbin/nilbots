      "urgency": "urgent",
      "orders": [
        {
          "id": "return-to-reactor",
          "move": {
            "to": "own-reactor"
          }
        }
      ]
    },
    "collect-loose-core": {
      "when": {
        "all": [
          "empty-handed",
          "loose-core-known"
        ]
      },
      "capacity": "two-per-core",
      "move": {
        "to": "nearest-known-loose-core"
      }
    },
    "recover-health": {
      "when": "hurt",
      "until": "healthy",
      "timeout": 16,
      "cooldown": 18,
      "urgency": "urgent",
      "orders": [
        {
          "id": "reach-healing",
          "move": {
            "to": "nearest-heal-zone",
            "posture": "rear"
          }
        }
      ]
    },
    "fight-visible-enemy": {
