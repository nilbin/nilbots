{
  "schema": "arc-relay-orders-v2",
  "sheetId": "hunter-tapline-v2",
  "mapPlan": "../map-plans/hunter-tapline-v2.json",
  "roles": [
    {
      "id": "hunter",
      "classes": ["kestrel"],
      "upgradePath": ["damage", "vision", "vitality"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        { "id": "dash-into-contact", "when": { "all": ["empty-handed", "enemy-visible", "signature-ready"] }, "use": { "skill": "vector-dash", "target": "nearest-enemy" } },
        { "shared": "fight-visible-enemy" },
        { "id": "shadow-hunt", "urgency": "routine", "move": { "patrol": "shadow-hunt-loop", "posture": "front" } }
      ]
    },
    {
      "id": "medic",
      "classes": ["patchbay"],
      "upgradePath": ["reach", "vitality"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        {
          "id": "repair-hunter",
          "when": { "all": ["hunter-hurt", "signature-ready"] },
          "use": { "skill": "repair-beam", "target": "weakest-ally" }
        },
        { "shared": "fight-visible-enemy" },
        { "id": "shadow-hunter", "move": { "follow": "hunter", "posture": "rear" } }
      ]
    },
    {
      "id": "hauler",
      "classes": ["relay"],
      "upgradePath": ["vitality", "vision"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "id": "arc-pass-forward", "when": { "all": ["carrying-core", "signature-ready"] }, "use": { "skill": "arc-toss", "target": "nearest-ally-toward-own-reactor" } },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        { "shared": "fight-visible-enemy" },
        { "id": "work-centre-well", "move": { "to": { "well": "centre" }, "posture": "line" } }
      ]
    },
    {
      "id": "home-runners",
      "classes": ["longshot", "longshot"],
      "upgradePath": ["damage", "vision", "vitality"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        { "id": "rail-weakest-target", "when": { "all": ["empty-handed", "enemy-visible", "signature-ready"] }, "use": { "skill": "rail-line", "target": "weakest-enemy" } },
        { "shared": "fight-visible-enemy" },
        { "id": "work-home-well", "move": { "to": { "well": "own" }, "posture": "rear" } }
      ]
    },
    {
      "id": "far-runners",
      "classes": ["towline", "towline"],
      "upgradePath": ["damage", "vision", "vitality"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        { "id": "hook-enemy-carrier", "when": { "all": ["empty-handed", "enemy-visible", "signature-ready"] }, "use": { "skill": "tractor-hook", "target": "enemy-carrier" } },
        { "shared": "fight-visible-enemy" },
        { "id": "work-far-well", "move": { "to": { "well": "enemy" }, "posture": "front" } }
      ]
    },
    {
      "id": "builder",
      "classes": ["mason"],
      "upgradePath": ["vitality", "vision"],
      "orders": [
        { "shared": "handoff-core-forward" },
        { "shared": "score-a-core" },
        { "shared": "recover-health" },
        { "shared": "collect-loose-core" },
        { "id": "fortify-enemy-lane-gate", "when": { "all": ["empty-handed", "enemy-nearby", "signature-ready"] }, "use": { "skill": "hardlight-block", "target": "nearest-enemy", "at": "enemy-lane-gate" } },
        { "shared": "fight-visible-enemy" },
        { "id": "stage-at-enemy-lane-gate", "urgency": "routine", "move": { "to": { "adjacentTo": "enemy-lane-gate" }, "posture": "front" } }
      ]
    }
  ],
  "sharedOrders": {
    "handoff-core-forward": {
      "when": "carrying-core",
      "handoff": { "target": "nearest-ally-toward-own-reactor" }
    },
    "score-a-core": {
      "when": "carrying-core",
      "urgency": "urgent",
      "until": "empty-handed",
      "timeout": 180,
      "cooldown": 2,
      "orders": [
        { "id": "return-to-reactor", "move": { "to": "own-reactor" } }
      ]
    },
    "recover-health": {
      "when": "hurt",
      "urgency": "urgent",
      "until": "healthy",
      "timeout": 75,
      "cooldown": 18,
      "orders": [
        { "id": "reach-healing", "move": { "to": "nearest-heal-zone", "posture": "rear" } }
      ]
    },
    "collect-loose-core": {
      "when": { "all": ["empty-handed", "loose-core-known"] },
      "capacity": "two-per-core",
      "move": { "to": "nearest-known-loose-core" }
    },
    "fight-visible-enemy": {
      "when": { "all": ["empty-handed", "enemy-nearby"] },
      "fight": { "targets": ["carrier", "weakest", "nearest"], "style": "advance", "chaseLimit": 4 }
    }
  },
  "capacities": {
    "two-per-core": 2
  },
  "conditions": {
    "carrying-core": { "fact": "self-carrying", "operator": "equals", "value": 1 },
    "empty-handed": { "fact": "self-carrying", "operator": "equals", "value": 0 },
    "hurt": { "fact": "self-health-percent", "operator": "at-most", "value": 35 },
    "healthy": { "fact": "self-health-percent", "operator": "at-least", "value": 75 },
    "loose-core-known": { "fact": "known-loose-cores", "operator": "at-least", "value": 1 },
    "enemy-visible": { "fact": "visible-enemies-in-zone", "operator": "at-least", "value": 1, "zone": "battlefield" },
    "enemy-nearby": { "fact": "self-nearest-visible-enemy-distance", "operator": "at-most", "value": 7 },
    "hunter-hurt": { "fact": "role-lowest-health-percent", "operator": "at-most", "value": 70, "role": "hunter" },
    "signature-ready": { "fact": "signature-ready", "operator": "equals", "value": 1 }
  }
}
