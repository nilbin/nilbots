        {
          "id": "open-field-couriers-field-work",
          "orders": [
            {
              "id": "open-field-couriers-field-work-carry-home",
              "when": "open-field-couriers-custody-carrying",
              "until": "open-field-couriers-custody-empty",
              "urgency": "urgent",
              "move": {
                "to": "own-reactor"
              }
            },
            {
              "id": "open-field-couriers-field-work-recover-core",
              "when": {
                "all": [
                  "open-field-couriers-field-work-empty-handed",
                  "open-field-couriers-field-work-core-nearby"
                ]
              },
              "capacity": "core-recovery",
              "move": {
                "to": "highest-bank-value-visible-loose-core",
                "withinWalkingSteps": 5
              }
            },
            {
              "id": "open-field-couriers-field-work-recover-health",
              "when": {
                "all": [
                  "open-field-couriers-field-work-health-low",
                  "open-field-couriers-field-work-healing-nearby",
                  "open-field-couriers-field-work-not-carrying"
                ]
              },
              "until": {
                "any": [
                  "open-field-couriers-field-work-health-recovered",
                  "open-field-couriers-field-work-became-carrier"
                ]
              },
              "timeout": 55,
              "cooldown": 20,
              "capacity": "healing",
              "move": {
                "to": "nearest-heal-zone",
                "withinWalkingSteps": 8
              }
            },
            {
              "id": "open-field-couriers-field-work-fight",
              "when": "open-field-couriers-field-work-contact",
              "capacity": 3,
              "fight": {
                "targets": [
                  "carrier",
                  "weakest",
                  "nearest"
                ],
                "style": "hold",
                "chaseLimit": 5
              }
            },
            {
              "id": "open-field-couriers-field-work-continue",
              "move": {
                "to": {
                  "well": "own"
                },
                "posture": "front"
              }
            }
          ]
        },
