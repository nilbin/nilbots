                  "use": {
                    "skill": "arc-toss",
                    "target": {
                      "role": "relay-b"
                    }
                  }
                },
                {
                  "id": "relay-chain-a-bank-final-approach",
                  "when": {
                    "all": [
                      "relay-chain-carrying-core",
                      "relay-chain-at-home-reactor"
                    ]
                  },
                  "until": "relay-chain-empty-handed",
                  "urgency": "urgent",
                  "move": {
                    "to": {
                      "anchor": "relay-chain-home-reactor"
                    }
                  }
                },
                {
                  "id": "relay-chain-a-carry-forward",
                  "when": "relay-chain-carrying-core",
                  "urgency": "normal",
                  "move": {
                    "patrol": "relay-chain-return-corridor"
                  }
                }
              ]
            },
            {
              "id": "relay-chain-a-run-after-toss",
