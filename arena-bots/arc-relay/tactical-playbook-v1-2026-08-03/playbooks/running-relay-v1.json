                    "all": [
                      "relay-chain-carrying-core",
                      "relay-chain-signature-ready",
                      "relay-chain-carrier-1-at-source",
                      "relay-chain-receiver-1-occupied"
                    ]
                  },
                  "use": {
                    "skill": "arc-toss",
                    "target": {
                      "role": "relay-b"
                    }
                  }
                },
                {
                  "id": "relay-chain-a-forward-toss-2",
