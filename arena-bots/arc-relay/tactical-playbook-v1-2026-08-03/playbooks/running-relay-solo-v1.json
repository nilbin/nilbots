    {
      "id": "relay-a",
      "classes": [
        "relay"
      ],
      "upgradePath": [
        "reach",
        "vitality"
      ],
      "orders": [
        {
          "id": "solo-corridor-return",
          "when": "solo-carrying",
          "until": "solo-empty",
          "urgency": "normal",
          "move": {
            "to": {
              "anchor": "relay-chain-home-reactor"
            },
            "via": "relay-chain-return-corridor"
          }
        },
        {
          "id": "solo-corridor-take-start",
          "move": {
            "to": {
              "anchor": "relay-chain-enemy-well-pickup"
            }
          }
        },
        {
          "id": "open-field-relay-a-field-work",
          "orders": [
            {
              "id": "open-field-relay-a-field-work-recover-core",
              "when": {
                "all": [
                  "open-field-relay-a-field-work-empty-handed",
                  "open-field-relay-a-field-work-core-nearby"
                ]
              },
              "capacity": "core-recovery",
              "move": {
                "to": "highest-bank-value-visible-loose-core",
                "withinWalkingSteps": 5
              }
            },
            {
              "id": "open-field-relay-a-field-work-recover-health",
              "when": {
                "all": [
                  "open-field-relay-a-field-work-health-low",
                  "open-field-relay-a-field-work-healing-nearby",
                  "open-field-relay-a-field-work-not-carrying"
                ]
              },
              "until": {
                "any": [
                  "open-field-relay-a-field-work-health-recovered",
                  "open-field-relay-a-field-work-became-carrier"
                ]
              },
              "timeout": 55,
              "cooldown": 20,
              "capacity": "healing",
              "move": {
                "to": "nearest-heal-zone",
                "withinWalkingSteps": 8
              }
            },
            {
              "id": "open-field-relay-a-field-work-fight",
              "when": "open-field-relay-a-field-work-contact",
              "capacity": 3,
              "fight": {
                "targets": [
                  "carrier",
                  "weakest",
                  "nearest"
                ],
                "style": "hold",
                "chaseLimit": 5
              }
            },
            {
              "id": "open-field-relay-a-field-work-continue",
              "move": {
                "to": {
                  "well": "own"
                },
                "posture": "front"
              }
            }
          ]
        },
        {
          "id": "relay-a-park",
          "move": {
            "to": "own-reactor"
          }
        }
      ]
    },
