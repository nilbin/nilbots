  "sharedOrders": {
    "score-a-core": {
      "when": "carrying-core",
      "until": "empty-handed",
      "timeout": 180,
      "cooldown": 2,
      "urgency": "urgent",
      "orders": [
        {
          "id": "return-to-reactor",
          "capacity": "reactor-lane-one",
          "move": {
            "to": "own-reactor"
          }
        }
      ]
    },
    "queue-loaded-core": {
      "when": "carrying-core",
      "urgency": "normal",
      "move": {
        "to": {
          "zone": "reactor-approach-queue"
        },
        "posture": "line"
      }
    },
    "collect-loose-core": {
      "when": {
        "all": [
          "empty-handed",
          "loose-core-known"
        ]
      },
      "capacity": "two-per-core",
      "move": {
        "to": "nearest-known-loose-core"
      }
    },
    "recover-health": {
      "when": "hurt",
      "until": "healthy",
      "timeout": 16,
      "cooldown": 18,
      "urgency": "urgent",
      "orders": [
        {
          "id": "reach-healing",
          "move": {
            "to": "nearest-heal-zone",
            "posture": "rear"
          }
        }
      ]
    },
    "answer-centre-column": {
      "when": {
        "any": [
          "centre-entry-surge",
          "centre-column-seen"
        ]
      },
      "until": "centre-response-earned",
      "timeout": 120,
      "cooldown": 12,
      "urgency": "urgent",
      "orders": [
        {
          "id": "break-centre-column",
          "when": {
            "all": [
              "empty-handed",
              "enemy-nearby"
            ]
          },
          "fight": {
            "targets": [
              "carrier",
              "veteran",
              "weakest",
              "nearest"
            ],
            "style": "hold",
            "chaseLimit": 3
          }
        },
        {
          "id": "form-centre-killbox",
          "when": "empty-handed",
          "capacity": "centre-response-six",
          "move": {
            "to": {
              "zone": "centre-killbox"
            },
            "posture": "line",
            "face": {
              "anchor": "centre-threat-axis"
            }
          }
        }
      ]
    },
    "fight-visible-enemy": {
      "when": {
        "all": [
          "empty-handed",
          "enemy-nearby"
        ]
      },
      "fight": {
        "targets": [
          "carrier",
          "weakest",
          "nearest"
        ],
        "style": "advance",
        "chaseLimit": 4
      }
    }
  },
  "capacities": {
    "two-per-core": 2,
    "reactor-lane-one": 1,
    "centre-response-six": 6
  },
  "conditions": {
    "carrying-core": {
      "fact": "self-carrying",
      "operator": "equals",
      "value": 1
    },
    "empty-handed": {
      "fact": "self-carrying",
      "operator": "equals",
      "value": 0
    },
    "loose-core-known": {
      "fact": "known-loose-cores",
      "operator": "at-least",
      "value": 1
    },
    "hurt": {
      "fact": "self-health-percent",
      "operator": "at-most",
      "value": 35
    },
    "healthy": {
      "fact": "self-health-percent",
      "operator": "at-least",
      "value": 75
    },
    "enemy-nearby": {
      "fact": "self-nearest-visible-enemy-distance",
      "operator": "at-most",
      "value": 7
    },
    "signature-ready": {
      "fact": "signature-ready",
      "operator": "equals",
      "value": 1
    },
    "deployment-missing": {
      "fact": "deployment-active",
      "operator": "equals",
      "value": 0
    },
    "deployment-expiring": {
      "fact": "deployment-lifetime-percent",
      "operator": "at-most",
      "value": 20
    },
    "deployment-damaged": {
      "fact": "deployment-durability-percent",
      "operator": "at-most",
      "value": 34
    },
    "centre-entry-surge": {
      "fact": "observed-enemy-entries-in-zone",
      "zone": "centre-pressure-gate",
      "windowTicks": 75,
      "operator": "at-least",
      "value": 3
    },
    "centre-column-seen": {
      "fact": "distinct-enemy-lives-observed-in-zone",
      "zone": "centre-pressure-gate",
      "windowTicks": 75,
      "operator": "at-least",
      "value": 4
    },
    "centre-response-earned": {
      "fact": "confirmed-enemy-destructions-in-zone",
      "zone": "centre-pressure-gate",
      "since": "node-entry",
      "operator": "at-least",
      "value": 3
    }
  }
