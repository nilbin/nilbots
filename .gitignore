bin/
obj/
*.user
.vs/
.idea/
node_modules/
web/dist/
web/dist-cli/
web/dist-review/
web/dist-gate3/
web/dist-site-review/
out/
*.binlog
artifacts/*
!artifacts/wasm/
artifacts/wasm/*
!artifacts/wasm/builtin-bots.wasm
!artifacts/wasm/builtin-bots.inputs
out/
sandbox/
var/
deploy/.env
deploy/release.env
deploy/release.previous.env
deploy/secrets/
deploy/backups/

# mobile (Expo)
mobile/.expo/
mobile/dist/
mobile/ios/
mobile/android/

# TypeScript incremental build cache — a local artifact, not source.
web/tsconfig.tsbuildinfo

# Baked atlas variants — generated from the 4096 masters by
# scripts/generate-atlas-variants.mjs, regenerated on dev/build.
web/src/assets/themes/*/variants/

# Vite-built renderer harness for golden-frame tests.
web/tests/.harness/

# Cached review replay selection, restored across rebuilds.
web/.review-cache/

# Source soundtrack archives are compiler inputs, never deployable assets.
# Keep this generic: future packs must not become tracked merely because their
# archive has a different title or was dropped in a subdirectory.
*.zip

# Frontline Labs runs are large local evidence archives. Commit the compact
# verdict/manifests explicitly (with `git add -f`) and keep full replay/log
# trees in the durable artifact store.
arena-bots/frontline-labs/**/evidence/
arena-bots/frontline-labs/**/smoke/
arena-bots/frontline-labs/**/revisions/
balance/private/

# Frontline map provider masters are retained locally for technical-art
# handoff, but are too large (and provider task URLs too ephemeral) for source
# control. Commit compact manifests, hashes, previews, and review renders.
art/frontline-map-models/provider-runs/**/raw-model.glb
art/frontline-map-models/provider-runs/**/texture-*.png
art/frontline-map-models/provider-runs/**/task.raw.json

# Class-model provider masters: same rule as the frontline map models above
# (DECISIONS #83 precedent). Meshy/provider raw output and multi-megabyte
# review renders are retained LOCALLY for technical-art handoff; the repo
# keeps the compact provenance (RUN.md, record/manifest/timing/artifacts
# JSON, preview.png) so a run stays reproducible and auditable.
art/class-models/provider-runs/**/*raw.glb
art/class-models/provider-runs/**/*review.glb
art/class-models/provider-runs/**/*-front.png
art/class-models/provider-runs/**/*-back.png
art/class-models/provider-runs/**/*-left.png
art/class-models/provider-runs/**/*-right.png
art/class-models/provider-runs/**/*-alpha.png
art/class-models/provider-runs/**/*.json.gz
art/class-models/concept-targets/**/approval-sheet.png
art/class-models/concept-targets/**/meshy-input.png
